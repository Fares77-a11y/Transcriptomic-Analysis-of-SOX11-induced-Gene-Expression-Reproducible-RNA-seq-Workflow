{
  "input": "samplesheet.csv",
  "outdir": "results/",
  "genome": "GRCh38",
  "aligner": "star_salmon",
  "pseudo_aligner": "kallisto",
  "skip_alignment": false,
  "skip_pseudo_alignment": false,
  "trimmer": "trimgalore",
  "min_trimmed_reads": 10000,
  "save_trimmed": true,
  "save_unaligned": false,
  "save_align_intermeds": false,
  "save_reference": true,
  "gencode": true,
  "gtf": "path/to/gencode.v38.annotation.gtf",
  "fasta": "path/to/GRCh38.primary_assembly.genome.fa",
  "transcript_fasta": "path/to/gencode.v38.transcripts.fa",
  "salmon_index": null,
  "kallisto_index": null,
  "star_index": null,
  "hisat2_index": null,
  "rsem_index": null,
  "save_merged_fastq": false,
  "skip_fastqc": false,
  "skip_multiqc": false,
  "skip_qc": false,
  "skip_deseq2_qc": false,
  "deseq2_vst": true,
  "rseqc_modules": "bam_stat,inner_distance,infer_experiment,junction_annotation,junction_saturation,read_distribution,read_duplication",
  "max_memory": "128.GB",
  "max_cpus": 16,
  "max_time": "240.h"
}
